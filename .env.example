# Absolute path; ?mode=rwc creates the file if missing (avoids sqlx "unable to open database file")
DATABASE_URL="sqlite:///home/user/intime-rs/crates/intime-storage/dev.db?mode=rwc"

# Optional embedding HTTP service (used when INTIME_EMBEDDINGS_ENABLED=true)
EMBEDDING_SERVER_URL="http://127.0.0.1:8000"

# Feature flags (true/false, 1/0, yes/no, on/off). Defaults shown.
# Screenshots and embedding jobs
INTIME_SCREENSHOTS_ENABLED=true
INTIME_EMBEDDINGS_ENABLED=true

# Richer UI metadata (focused control name/class/type/automation id)
INTIME_RICH_UI_METADATA=true

# Infer document paths / URLs / workspace hints from window titles (more intrusive)
INTIME_DOCUMENT_CONTEXT=true

# Group raw events into heuristic sessions (category + context merges)
INTIME_SESSION_GROUPING=true

# Future: allow LLM activity-rule / session labeling when idle / on demand (off by default)
INTIME_SESSION_LLM=false
